BOT_NAME=binance-trend-only
POLLING_SECONDS=60
TELEGRAM_POLL_SECONDS=5

# Binance USDT-M futures execution.
EXCHANGE=binance_futures
BINANCE_MARKET_TYPE=usdtm
BINANCE_BASE_URL=https://api.binance.com
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_FUTURES_LEVERAGE=1

# Use all tradable Binance USDT-M perpetuals, ranked by 24h quote volume.
# Set BINANCE_SYMBOL_LIMIT=100 if you want only the top 100 liquid contracts.
SYMBOLS=auto
BINANCE_AUTO_SYMBOLS=true
BINANCE_SYMBOL_LIMIT=150
SYMBOL_REFRESH_SECONDS=3600
BINANCE_EXCLUDED_SYMBOLS=XAUUSDT,XAGUSDT,PAXGUSDT,XAUTUSDT

# Strategy and risk controls.
CANDLE_INTERVAL=1h
INITIAL_EQUITY=1000
RISK_PER_TRADE=0.015
MAX_OPEN_POSITIONS=7
MAX_POSITION_NOTIONAL_PCT=0.20
EMA_SPAN=80
MOMENTUM_BARS=24
BREAKOUT_LOOKBACK=16
EXIT_LOOKBACK=24
MAX_HOLD_BARS=216
TRAILING_STOP_PCT=0.06
TREND_EMA_EXIT_BUFFER_PCT=0.025
TRANCHE_SCHEME=0.35,0.35,0.30
ADD_DELAY_BARS=8
USE_BTC_FILTER=false

# Market orders are safer for live Binance futures exits. Use limit only if
# you are comfortable with unfilled/pending orders.
DEFAULT_ORDER_TYPE=market
LIVE_TRADING=false

# Optional Telegram operator interface.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_LOG_ID=
